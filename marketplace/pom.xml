<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.confluo</groupId>
        <artifactId>confluo-backend</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>marketplace</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>marketplace</name>
    <description>A sale between two people, and money going back: destination charges, checkout and refunds</description>

    <dependencies>
        <!-- The entity base, the repository base and the RSQL filter - and through it
             common-core, which brings the web, validation and security starters and the Swagger
             annotations the controllers are documented with. -->
        <dependency>
            <groupId>com.confluo</groupId>
            <artifactId>common-jpa</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- Publishing what this subject learns, through the outbox. -->
        <dependency>
            <groupId>com.confluo</groupId>
            <artifactId>common-amqp</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- The gateways, and the exception they throw. -->
        <dependency>
            <groupId>com.confluo</groupId>
            <artifactId>payments-stripe</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- StripeEventHandler: the interface the mirroring handlers implement. -->
        <dependency>
            <groupId>com.confluo</groupId>
            <artifactId>payments-webhook</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.confluo</groupId>
            <artifactId>onboarding</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- A sale is charged on the platform's account with the seller's as the transfer
             destination, so a payment cannot be recorded without their connected account. -->
        <dependency>
            <groupId>com.stripe</groupId>
            <artifactId>stripe-java</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
