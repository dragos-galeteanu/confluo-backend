# Copy to .env and fill in. Values here are the local defaults; nothing secret belongs in this file.

# Google Cloud project whose Firebase tokens the platform accepts. Required - the services build
# their OIDC issuer from it (https://securetoken.google.com/<project-id>) and will not start
# without it.
FIREBASE_PROJECT_ID=

# Where the platform service is published on the host.
PLATFORM_PORT=8081

# PostgreSQL, which holds the countries, currencies and languages.
POSTGRES_DB=confluo_platform
POSTGRES_USER=confluo
POSTGRES_PASSWORD=confluo
POSTGRES_PORT=5432

# MongoDB, which holds the feature flags.
MONGO_DB=confluo_platform
MONGO_PORT=27017

# RabbitMQ, which carries events between the services. One user on the default vhost is enough
# locally; a deployed environment gives each service its own user and scopes its permissions.
RABBITMQ_USER=confluo
RABBITMQ_PASSWORD=confluo
RABBITMQ_VHOST=/
RABBITMQ_PORT=5672
# The management UI, on http://localhost:15672 with the user and password above. This is where a
# message that has run out of attempts is found, read and replayed.
RABBITMQ_MANAGEMENT_PORT=15672
# classic locally, where a single node is the whole cluster. Deployed environments set quorum.
# Note that a queue's type cannot be changed after it is declared.
RABBITMQ_QUEUE_TYPE=classic

# Zipkin, where one trace covering several services can be read. http://localhost:9411
ZIPKIN_PORT=9411
# Every trace is kept locally, because there are few of them and losing the interesting one is
# worse than the cost. Deployed environments sample a fraction.
TRACING_SAMPLE_RATE=1.0

