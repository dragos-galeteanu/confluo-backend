# Copy to .env and fill in. Values here are the local defaults; nothing secret belongs in this file.

# Google Cloud project whose Firebase tokens the platform accepts. Required - the services build
# their OIDC issuer from it (https://securetoken.google.com/<project-id>) and will not start
# without it.
FIREBASE_PROJECT_ID=

# Where the platform service is published on the host.
PLATFORM_PORT=8081

# PostgreSQL, which holds the countries, currencies and languages.
POSTGRES_DB=confluo_platform
POSTGRES_USER=confluo
POSTGRES_PASSWORD=confluo
POSTGRES_PORT=5432

# MongoDB, which holds the feature flags.
MONGO_DB=confluo_platform
MONGO_PORT=27017

