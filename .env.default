# Copy to .env and fill in. Values here are the local defaults; nothing secret belongs in this file.

# Google Cloud project whose Firebase tokens the platform accepts. Required - the services build
# their OIDC issuer from it (https://securetoken.google.com/<project-id>) and will not start
# without it.
FIREBASE_PROJECT_ID=

# Where the services are published on the host.
PLATFORM_PORT=8081
NOTIFICATIONS_PORT=8082
PAYMENTS_PORT=8083

# PostgreSQL. POSTGRES_DB is the platform's and is the one the image creates itself; every other
# service's database is created by docker/postgres/ when the volume is first initialised, which
# means a volume that predates that script will not have them.
POSTGRES_DB=confluo_platform
NOTIFICATIONS_DB=confluo_notifications
PAYMENTS_DB=confluo_payments
POSTGRES_USER=confluo
POSTGRES_PASSWORD=confluo
POSTGRES_PORT=5432

# MongoDB. The platform's holds the feature flags; the notifications service's holds the message
# templates and the rendered copy of everything it has sent; the payments service's holds the raw
# body of every Stripe webhook, which is the only copy of what Stripe actually said.
MONGO_DB=confluo_platform
NOTIFICATIONS_MONGO_DB=confluo_notifications
PAYMENTS_MONGO_DB=confluo_payments
MONGO_PORT=27017

# Redis, which holds the notification rate limits, the deduplication windows and the per-provider
# token buckets, and on the payments side the webhook in-flight locks and the bucket in front of
# Stripe's own rate limits. Nothing in it is persisted: a counter that forgets itself on a restart
# is correct, and every decision it holds is one the databases can also make, only more expensively.
REDIS_PORT=6379

# RabbitMQ, which carries events between the services. One user on the default vhost is enough
# locally; a deployed environment gives each service its own user and scopes its permissions.
RABBITMQ_USER=confluo
RABBITMQ_PASSWORD=confluo
RABBITMQ_VHOST=/
RABBITMQ_PORT=5672
# The management UI, on http://localhost:15672 with the user and password above. This is where a
# message that has run out of attempts is found, read and replayed.
RABBITMQ_MANAGEMENT_PORT=15672
# classic locally, where a single node is the whole cluster. Deployed environments set quorum.
# Note that a queue's type cannot be changed after it is declared.
RABBITMQ_QUEUE_TYPE=classic

# Mailpit, the local mail catcher: it accepts every message and delivers none, and the web UI on
# http://localhost:8025 is where a rendered email is actually read. Nothing in development sends
# through the real Google account - its ~500 messages a day are shared with whoever reads that
# mailbox, and one test loop spends them.
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# Zipkin, where one trace covering several services can be read. http://localhost:9411
ZIPKIN_PORT=9411
# Every trace is kept locally, because there are few of them and losing the interesting one is
# worse than the cost. Deployed environments sample a fraction.
TRACING_SAMPLE_RATE=1.0

# Stripe, test mode locally. All three are secrets and all three are blank here on purpose: fill
# them in .env, which is not committed.
#
# The secret key is the account's full authority over money. The two signing secrets are what make
# a webhook request trustworthy - these endpoints carry no user token, so the signature is the only
# authentication they have, and a service started without the right secret cannot tell Stripe's own
# POST from a forged one. All three are therefore required rather than defaulted: a payments service
# that starts half-configured fails at the first charge, which is the worst place to find out.
#
# The two webhook secrets are different values. Stripe issues one per registered endpoint, and the
# platform's own events and the connected accounts' events are two endpoints. Locally both come
# from the Stripe CLI, which prints one when it starts forwarding:
#
#   stripe listen --forward-to localhost:8083/api/payments/webhooks/stripe
#   stripe listen --forward-connect-to localhost:8083/api/payments/webhooks/stripe/connect
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=

# The platform's default cut of a marketplace sale, in basis points: 250 is 2.5%. A provider on a
# paid tier can be charged less, which is what a plan's fee override is for - this is the default
# everyone else pays.
PLATFORM_FEE_BPS=250
# Where Stripe returns the payer. {CHECKOUT_SESSION_ID} is substituted by Stripe, and the success
# page must not treat being reached as proof of payment - a payer can open that URL themselves.
CHECKOUT_SUCCESS_URL=http://localhost:3000/checkout/success?session={CHECKOUT_SESSION_ID}
CHECKOUT_CANCEL_URL=http://localhost:3000/checkout/cancelled

# Where Stripe sends a seller during and after Connect onboarding. The return URL is reached the
# moment the form is submitted, which is NOT the same as being verified - that arrives later on an
# account.updated webhook, so the page must not claim the seller is live. The refresh URL is where
# Stripe sends somebody whose link went stale: an account link is single-use and lives minutes, so
# that page has to request a fresh link and redirect again.
CONNECT_RETURN_URL=http://localhost:3000/connect/onboarding/done
CONNECT_REFRESH_URL=http://localhost:3000/connect/onboarding/refresh

# Where Stripe sends somebody after they submit identity documents. Reaching it means submitted,
# not verified: the checks run afterwards and the answer arrives on a webhook, sometimes minutes
# later, so this page must not claim they are verified.
IDENTITY_RETURN_URL=http://localhost:3000/identity/submitted
